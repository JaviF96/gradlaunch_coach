# Copy this file to .env and fill in your real key.
# Never commit the real .env file to git.

ANTHROPIC_API_KEY=your_key_here

# Comma-separated list of origins allowed to call this API. Defaults to
# http://localhost:5500 if unset. Set this to your deployed frontend URL
# once you deploy (e.g. https://your-frontend.onrender.com).
# ALLOWED_ORIGINS=http://localhost:5500
